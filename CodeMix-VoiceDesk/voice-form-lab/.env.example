# Local demonstration values only. Copy to .env and change both passwords.
DB_USER=lab
DB_PASSWORD=local-db-change-me
DEMO_USER=reviewer
DEMO_PASSWORD=local-demo-change-me
CORS_ORIGIN=http://localhost:5173
RETAIN_AUDIO=false
PUBLIC_INTAKE_ENABLED=true
# Telephone intake is off until a real provider account, inbound number and HTTPS origin are configured.
PHONE_ENABLED=false
PHONE_PUBLIC_BASE_URL=
PHONE_PUBLIC_NUMBER=
PHONE_PROMPTS_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
