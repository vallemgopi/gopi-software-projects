{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "declaration": true
  },
  "include": [
    "mcp/**/*.ts",
    "client/**/*.ts",
    "widget/**/*.ts",
    "examples/**/*.ts"
  ]
}
